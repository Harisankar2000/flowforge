NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://flowforge:flowforge@localhost:5433/flowforge?schema=public
REDIS_URL=redis://localhost:6380

# Comma-separated API keys. Leave empty to disable authentication (local development only).
API_KEYS=dev-secret-key

QUEUE_PREFIX=flowforge
WORKER_CONCURRENCY=10
WORKER_METRICS_PORT=9100
RATE_LIMIT_MAX=100

# Optional comma-separated allowlist for HTTP steps, e.g. "api.example.com,*.internal.example.com".
# Leave empty to allow any host.
HTTP_STEP_ALLOWED_HOSTS=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StepStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

enum TriggerType {
  MANUAL
  CRON
}

model Workflow {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @unique
  description    String?
  /// Validated DAG definition: { steps: StepDefinition[] }
  definition     Json
  version        Int           @default(1)
  cronExpression String?       @map("cron_expression")
  cronTimezone   String?       @map("cron_timezone")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  runs           WorkflowRun[]

  @@map("workflows")
}

model WorkflowRun {
  id              String       @id @default(uuid()) @db.Uuid
  workflowId      String       @map("workflow_id") @db.Uuid
  workflowVersion Int          @map("workflow_version")
  /// Snapshot of the definition at trigger time, so edits never affect in-flight runs.
  definition      Json
  status          RunStatus    @default(PENDING)
  trigger         TriggerType
  input           Json?
  output          Json?
  error           String?
  idempotencyKey  String?      @map("idempotency_key")
  startedAt       DateTime?    @map("started_at")
  finishedAt      DateTime?    @map("finished_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  workflow        Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps           StepRun[]
  deadLetters     DeadLetter[]

  @@unique([workflowId, idempotencyKey])
  @@index([workflowId, createdAt(sort: Desc)])
  @@index([status])
  @@map("workflow_runs")
}

model StepRun {
  id         String      @id @default(uuid()) @db.Uuid
  runId      String      @map("run_id") @db.Uuid
  stepKey    String      @map("step_key")
  type       String
  status     StepStatus  @default(PENDING)
  attempts   Int         @default(0)
  input      Json?
  output     Json?
  error      String?
  startedAt  DateTime?   @map("started_at")
  finishedAt DateTime?   @map("finished_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepKey])
  @@map("step_runs")
}

/// Steps that exhausted their retries. Kept for inspection and manual replay.
model DeadLetter {
  id         String      @id @default(uuid()) @db.Uuid
  runId      String      @map("run_id") @db.Uuid
  stepKey    String      @map("step_key")
  error      String
  attempts   Int
  payload    Json
  resolvedAt DateTime?   @map("resolved_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt(sort: Desc)])
  @@map("dead_letters")
}
